${yamlencode({
  apiVersion = "oadp.openshift.io/v1alpha1"
  kind = "DataProtectionApplication"
  metadata = {
    name = "rosa-dpa", namespace = "openshift-adp"
    labels = { "app.kubernetes.io/part-of" = "rosa-gitops-layers", "app.kubernetes.io/component" = "oadp" }
  }
  spec = {
    # Registry mirroring/backup is a separate workflow; VM disks are CSI volumes.
    backupImages = false
    backupLocations = [{
      velero = {
        provider = "aws"
        default = true
        config = { enableSharedConfig = "true", profile = "default", region = region }
        credential = { key = "credentials", name = "cloud-credentials" }
        objectStorage = { bucket = bucket_name, prefix = "velero" }
      }
    }]
    configuration = {
      nodeAgent = {
        enable = true
        uploaderType = "kopia"
        podConfig = { tolerations = node_agent_tolerations }
      }
      velero = {
        defaultPlugins = concat(["openshift", "aws", "csi"], virtualization_enabled ? ["kubevirt"] : [])
        defaultSnapshotMoveData = true
        disableFsBackup = !config.filesystem_backup_enabled
        resourceTimeout = "10m"
      }
    }
  }
})}
