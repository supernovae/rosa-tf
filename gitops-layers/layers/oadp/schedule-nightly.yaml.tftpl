${yamlencode({
  apiVersion = "velero.io/v1"
  kind = "Schedule"
  metadata = {
    name = "nightly-user-backup", namespace = "openshift-adp"
    labels = { "rosa.cluster.name" = cluster_name, "app.kubernetes.io/component" = "oadp" }
  }
  spec = {
    schedule = config.schedule
    paused = config.schedule_paused
    useOwnerReferencesInBackup = false
    template = {
      ttl = "${backup_retention_days * 24}h"
      includedNamespaces = config.included_namespaces
      # Omit includeClusterResources: Velero's auto mode includes related PVs;
      # false would lose required related cluster-scoped objects.
      snapshotVolumes = true
      snapshotMoveData = true
      defaultVolumesToFsBackup = false
      storageLocation = "rosa-dpa-1"
    }
  }
})}
