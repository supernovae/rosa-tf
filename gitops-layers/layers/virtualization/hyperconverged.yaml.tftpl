${yamlencode({
  apiVersion = "hco.kubevirt.io/v1beta1"
  kind       = "HyperConverged"
  metadata = {
    name = "kubevirt-hyperconverged"
    namespace = "openshift-cnv"
  }
  spec = merge({
    uninstallStrategy = "BlockUninstallIfWorkloadsExist"
    infra = {
      nodePlacement = {
        nodeSelector = config.infra_node_selector
        tolerations  = config.infra_tolerations
      }
    }
    workloads = {
      nodePlacement = {
        nodeSelector = node_selector
        tolerations  = tolerations
      }
    }
  }, modern_boot_field ? {
    enableCommonBootImageImport = config.common_boot_images
  } : {}, modern_boot_field ? {} : {
    # Compatibility only: 4.18 HCO uses the feature gate.
    featureGates = { enableCommonBootImageImport = config.common_boot_images }
  })
})}
