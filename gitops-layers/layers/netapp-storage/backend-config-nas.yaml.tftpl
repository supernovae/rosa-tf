${yamlencode({
  apiVersion = "trident.netapp.io/v1"
  kind = "TridentBackendConfig"
  metadata = { name = "backend-fsx-ontap-nas", namespace = "trident" }
  spec = {
    version = 1
    storageDriverName = "ontap-nas"
    backendName = "backend-fsx-ontap-nas"
    managementLIF = management_endpoint
    dataLIF = nfs_endpoint
    svm = svm_name
    credentials = { name = backend_secret }
    useREST = true
    trustedCACertificate = base64encode(config.trusted_ca_pem)
    deletionPolicy = "retain"
    autoExportPolicy = true
    autoExportCIDRs = client_cidrs
    labels = { rosaLayer = "netapp-storage" }
    defaults = merge({
      unixPermissions = config.nas_unix_permissions
      securityStyle = "unix"
      spaceReserve = "none"
      snapshotPolicy = "none"
      tieringPolicy = "none"
    }, config.qos_policy != "" ? { qosPolicy = config.qos_policy } : {})
  }
})}
