${yamlencode({
  apiVersion = "trident.netapp.io/v1"
  kind = "TridentBackendConfig"
  metadata = { name = "backend-fsx-ontap-san", namespace = "trident" }
  spec = {
    version = 1
    storageDriverName = "ontap-san"
    backendName = "backend-fsx-ontap-san"
    sanType = "iscsi"
    managementLIF = management_endpoint
    # No SAN dataLIF: discover all target portals for multipathing.
    svm = svm_name
    credentials = { name = backend_secret }
    useREST = true
    trustedCACertificate = base64encode(config.trusted_ca_pem)
    useCHAP = config.use_chap
    deletionPolicy = "retain"
    labels = { rosaLayer = "netapp-storage" }
    defaults = merge({
      spaceAllocation = "true"
      spaceReserve = "none"
      snapshotPolicy = "none"
      tieringPolicy = "none"
    }, config.qos_policy != "" ? { qosPolicy = config.qos_policy } : {})
  }
})}
