${yamlencode({
  apiVersion = "trident.netapp.io/v1"
  kind = "TridentOrchestrator"
  # The CR is cluster-scoped; only spec.namespace selects the operand namespace.
  metadata = { name = "trident" }
  spec = merge({
    namespace = "trident"
    logLevel = log_level
    logFormat = "json"
    disableAuditLog = false
    enableForceDetach = config.enable_force_detach
    enableConcurrency = config.enable_concurrency
    silenceAutosupport = true
    kubeletDir = "/var/lib/kubelet"
    fsGroupPolicy = "File"
    nodePrep = config.node_prep_iscsi ? ["iscsi"] : []
    imagePullSecrets = config.image_pull_secrets
  }, trident_image != "" ? { tridentImage = trident_image } : {},
     config.image_registry != "" ? { imageRegistry = config.image_registry } : {})
})}
